NEBIUS_API_KEY=
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_AI_PROJECT=

# Canonical Sandbox SDK project ID; smoke script also accepts NEBIUS_AI_PROJECT.
NEBIUS_PROJECT_ID=

# Hosted preview settings must be injected into the process environment.
ASTERISK_PUBLIC=0
ASTERISK_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
ASTERISK_PREVIEW_PASSWORD=
ASTERISK_DB=.data/asterisk.sqlite
ASTERISK_PROBE_IMAGE=
# Must match the installed primitive driver when overriding the image.
ASTERISK_PROBE_DRIVER_SHA256=

# Ladder provider-call reservations per UTC day (0 disables remote operations).
# A proposal reserves 2 calls for initial+repair; a Sandbox replay reserves 1.
ASTERISK_LADDER_SESSION_DAILY_CALLS=10
ASTERISK_LADDER_GLOBAL_DAILY_CALLS=100
